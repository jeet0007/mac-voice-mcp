#!/bin/sh
# Stands in for the built call bubble: logs its start and its stop, and records what arrives on its
# stdin (the live transcript's JSON lines) in "$STUB_LOG.bubble-stdin".
echo "bubble start $VOICE_MCP_CACHE_DIR" >> "$STUB_LOG"
exec 3<&0 # a background job would get /dev/null as its stdin
cat <&3 >> "$STUB_LOG.bubble-stdin" &
reader=$!
trap 'kill $reader 2>/dev/null; echo "bubble stopped" >> "$STUB_LOG"; exit 0' TERM
while :; do sleep 0.1; done
