#!/usr/bin/env node
// Stub SoX `rec`: streams synthetic 16 kHz mono s16le audio to stdout at 10x real time.
// STUB_SCENARIO: answer | cough | silent | zero | long | call | dies (the recorder fails after a second)
//   | talk (noise; 1.5 s of speech each time the file $STUB_LOG.talk appears, which it removes)
//   | bargein (noise until a second text is spoken, then 1.5 s of speech over it, logged as "rec speech-onset <ms>")
// STUB_SCENARIO_LATER: another scenario for every recording after the first (e.g. silence while Claude works).
const fs = require("fs");
// First, so a stop that comes while the audio below is still being built is logged too.
process.on("SIGTERM", () => {
  fs.appendFileSync(process.env.STUB_LOG, "rec stopped\n");
  process.exit(0);
});
fs.appendFileSync(process.env.STUB_LOG, `rec ${process.argv.slice(2).join(" ")}\n`);
const runs = fs.readFileSync(process.env.STUB_LOG, "utf8").match(/^rec /gm).length;
const SR = 16000;
let seed = 7;
const rand = () => ((seed = (seed * 1103515245 + 12345) & 0x7fffffff) / 0x7fffffff) * 2 - 1;
const noise = (sec, amp = 40) => Array.from({ length: Math.round(SR * sec) }, () => Math.round(rand() * amp));
// Speech-like: a 180 Hz voice with a 4 Hz syllable envelope, loud enough to stand out.
const speech = (sec) => Array.from({ length: Math.round(SR * sec) }, (_, i) =>
  Math.round(8000 * Math.sin((2 * Math.PI * 180 * i) / SR) * (0.55 + 0.45 * Math.sin((2 * Math.PI * 4 * i) / SR))));
const burst = (sec) => Array.from({ length: Math.round(SR * sec) }, (_, i) => (i % 2 ? 9000 : -9000));
const scenario = (runs > 1 && process.env.STUB_SCENARIO_LATER) || process.env.STUB_SCENARIO || "answer";
// Built only for the scenario in use ("long" is a minute of audio).
const script = {
  answer: () => [noise(1), speech(1.5), noise(0.6), speech(1.2)], // a mid-answer pause shorter than 1.2 s
  cough: () => [noise(1), burst(0.15), noise(2), speech(1.5)],
  silent: () => [],
  zero: () => [],
  long: () => [noise(0.5), speech(60)],
  // Two utterances, the first after the call's greeting and the second 2 s (real time) later, then silence for good.
  call: () => [noise(5), speech(1.5), noise(20), speech(1.5), noise(2.5)],
  dies: () => [noise(10)],
  bargein: () => [],
  talk: () => [],
}[scenario]();
const frames = [];
for (const part of script) for (let i = 0; i < part.length; i += 480) frames.push(part.slice(i, i + 480));
const tailFrame = () => (scenario === "zero" ? new Array(480).fill(0) : noise(0.03));
process.stdout.on("error", () => process.exit(0));
let i = 0;
let spoken = false;
setInterval(() => {
  if (scenario === "bargein" && !spoken && (fs.readFileSync(process.env.STUB_LOG, "utf8").match(/^speak "/gm)?.length ?? 0) >= 2) {
    spoken = true;
    fs.appendFileSync(process.env.STUB_LOG, `rec speech-onset ${Date.now()}\n`);
    const s = speech(1.5);
    for (let j = 0; j < s.length; j += 480) frames.push(s.slice(j, j + 480));
  }
  if (scenario === "talk" && fs.existsSync(`${process.env.STUB_LOG}.talk`)) {
    fs.rmSync(`${process.env.STUB_LOG}.talk`);
    const s = speech(1.5);
    for (let j = 0; j < s.length; j += 480) frames.push(s.slice(j, j + 480));
  }
  if (scenario === "dies" && i >= frames.length) {
    process.stderr.write("rec FAIL: device unplugged\n");
    process.exit(1);
  }
  const f = i < frames.length ? frames[i++] : tailFrame();
  const buf = Buffer.alloc(f.length * 2);
  f.forEach((v, j) => buf.writeInt16LE(v, j * 2));
  process.stdout.write(buf);
}, 3);
