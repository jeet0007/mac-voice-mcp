#!/usr/bin/env node
// Stub whisper-server: /health (503 while "loading", then 200) and /inference.
const fs = require("fs"), http = require("http");
const args = process.argv.slice(2);
// STUB_NO_VAD: a whisper.cpp from before VAD, which doesn't list --vad and exits on it.
if (args.includes("--help")) {
  process.stderr.write(`usage: whisper-server [options]\n  -m FNAME, --model FNAME\n${process.env.STUB_NO_VAD ? "" : "  --vad\n"}`);
  process.exit(0);
}
if (process.env.STUB_NO_VAD && args.includes("--vad")) {
  process.stderr.write("error: unknown argument: --vad\n");
  process.exit(1);
}
const port = Number(args[args.indexOf("--port") + 1]);
const log = (m) => fs.appendFileSync(process.env.STUB_LOG, m + "\n");
if (process.env.STUB_PID_FILE) fs.writeFileSync(process.env.STUB_PID_FILE, String(process.pid));
log(`whisper-server start ${args.join(" ")}`);
const readyAt = Date.now() + 300;
http.createServer((req, res) => {
  if (req.url === "/health") {
    res.writeHead(Date.now() >= readyAt ? 200 : 503).end(JSON.stringify({ status: Date.now() >= readyAt ? "ok" : "loading model" }));
  } else if (req.url === "/inference" && req.method === "POST") {
    let n = 0;
    req.on("data", (d) => (n += d.length));
    req.on("end", () => {
      log(`whisper-server inference bytes=${n}`);
      if (process.env.STUB_STT_FAIL && fs.existsSync(process.env.STUB_STT_FAIL)) return res.writeHead(500).end("stub: model failed to load");
      // STUB_STT_DELAY_MS: a transcription that takes a while (so the Pop is already playing when the words are known).
      setTimeout(
        () => res.writeHead(200, { "content-type": "application/json" }).end(JSON.stringify({ text: ` ${process.env.STUB_TRANSCRIPT ?? "Stub transcript from the server."}\n` })),
        Number(process.env.STUB_STT_DELAY_MS || 0),
      );
    });
  } else res.writeHead(404).end();
}).listen(port, "127.0.0.1");
