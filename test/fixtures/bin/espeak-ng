#!/usr/bin/env node
// Stub TTS: records what would have been spoken. With -w FILE, writes 1 s of 16 kHz WAV instead.
const fs = require("fs");
const args = process.argv.slice(2);
const out = args.includes("-w") ? args[args.indexOf("-w") + 1] : null;
let text = "";
process.stdin.on("data", (d) => (text += d));
process.stdin.on("end", () => {
  if (out) {
    // STUB_TTS_SHORT=1: write almost no audio (a voice missing its data); =once: only the first time.
    const flag = process.env.STUB_TTS_SHORT;
    const marker = process.env.STUB_LOG + ".tts-short";
    const short = flag === "1" || (flag === "once" && !fs.existsSync(marker));
    if (flag === "once") fs.writeFileSync(marker, "");
    const pcm = Buffer.alloc(short ? 2000 : 32000);
    for (let i = 0; i < pcm.length / 2; i++) pcm.writeInt16LE(Math.round(6000 * Math.sin((2 * Math.PI * 220 * i) / 16000)), i * 2);
    const h = Buffer.alloc(44);
    h.write("RIFF", 0); h.writeUInt32LE(36 + pcm.length, 4); h.write("WAVE", 8); h.write("fmt ", 12);
    h.writeUInt32LE(16, 16); h.writeUInt16LE(1, 20); h.writeUInt16LE(1, 22); h.writeUInt32LE(16000, 24);
    h.writeUInt32LE(32000, 28); h.writeUInt16LE(2, 32); h.writeUInt16LE(16, 34); h.write("data", 36); h.writeUInt32LE(pcm.length, 40);
    fs.writeFileSync(out, Buffer.concat([h, pcm]));
    fs.appendFileSync(process.env.STUB_LOG, `speak-to-file ${JSON.stringify(text)}\n`);
  } else {
    fs.appendFileSync(process.env.STUB_LOG, `speak ${JSON.stringify(text)}\n`);
  }
});
